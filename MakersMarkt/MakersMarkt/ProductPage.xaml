<Page
    x:Class="MakersMarkt.ProductPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MakersMarkt.Data"
    Background="#FFFDF5D9">
    <!-- Very Light Yellow Background -->

    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Search & Filter Section -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
            <!-- Search Box -->
            <TextBox 
            x:Name="SearchBox" 
            PlaceholderText="Search products..." 
            Width="300" 
            Padding="8"
            BorderThickness="1"
            BorderBrush="#FFDFAF2B" 
            Background="White" 
            Foreground="#FF4C3000"
            PlaceholderForeground="#FF977500"
            CornerRadius="8"
            TextChanged="SearchBox_TextChanged"/>

        <ComboBox 
            x:Name="CategoryDropdown" 
            Width="180" 
            Padding="8"
            BorderThickness="1"
            BorderBrush="#FFDFAF2B" 
            Background="White"  
            Foreground="#FF4C3000"
            CornerRadius="8"
            SelectionChanged="CategoryDropdown_SelectionChanged"/>
        </StackPanel>


        <!-- Product List with Smooth Scrolling -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ListView 
                x:Name="ProductListView" 
                ItemsSource="{x:Bind Products}" 
                SelectionChanged="ProductListView_SelectionChanged"
                Background="Transparent"
                BorderThickness="0"
                Padding="5">

                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:Product">
                        <Border 
                            Background="White" 
                            CornerRadius="10" 
                            Padding="10" 
                            Margin="5"
                            BorderBrush="#FFDFAF2B"
                            BorderThickness="1">

                            <StackPanel>
                                <TextBlock 
                                    Text="{x:Bind Name}" 
                                    FontSize="22" 
                                    FontWeight="Bold" 
                                    Foreground="#FF634700"/>

                                <TextBlock 
                                    Text="{x:Bind Description}" 
                                    Foreground="Gray" 
                                    FontSize="16" 
                                    TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </ScrollViewer>

        <!-- Logout Button -->
        <Button 
            Grid.Row="2" 
            Content="Log Out" 
            HorizontalAlignment="Center" 
            VerticalAlignment="Bottom" 
            Click="LogoutButton_Click"
            Background="#FFDFAF2B" 
            Foreground="White"
            FontWeight="Bold"
            Width="140"
            Height="40"
            CornerRadius="8"/>
    </Grid>
</Page>
