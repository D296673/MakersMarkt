<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MakersMarkt.OrderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MakersMarkt.Data"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="30">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Background="#F4D35E" Padding="20" Spacing="15" Grid.Column="0"
                CornerRadius="10">
            <TextBlock Text="User Profile" FontSize="22" FontWeight="Bold" Foreground="Black"/>
            <TextBlock Text="Name:" FontWeight="SemiBold" Foreground="Black"/>
            <TextBlock x:Name="UserNameText" FontSize="18" Foreground="Black"/>

            <TextBlock Text="Role:" FontWeight="SemiBold" Foreground="Black"/>
            <TextBlock x:Name="UserRoleText" FontSize="18" Foreground="Black"/>

            <TextBlock Text="Joined:" FontWeight="SemiBold" Foreground="Black"/>
            <TextBlock x:Name="UserCreatedAtText" FontSize="18" Foreground="Black"/>

            <Button Content="Log Out" Click="Logout_Click" 
                Background="#E74C3C" Foreground="White"
                HorizontalAlignment="Stretch" CornerRadius="8"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Padding="20" Spacing="10">
            <TextBlock Text="Your Products" FontSize="22" FontWeight="Bold" Margin="0,0,0,10"
                   Foreground="Black"/>

            <ListView x:Name="UserOrdersListView">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:Order">
                        <Border Background="White" Padding="10" CornerRadius="8"
                    BorderBrush="Gray" BorderThickness="1">
                            <StackPanel Spacing="5">
                                <TextBlock Text="{x:Bind Product.Name}" FontSize="18" FontWeight="Bold" Foreground="Black"/>
                                <TextBlock Text="Buyer: {x:Bind Buyer.Name}" Foreground="Gray"/>
                                <TextBlock Text="Status:" FontWeight="SemiBold" Foreground="Black"/>
                                <ComboBox SelectedItem="{x:Bind Status, Mode=TwoWay}" SelectionChanged="StatusChanged">
                                    <ComboBoxItem Content="Pending"/>
                                    <ComboBoxItem Content="Accepted"/>
                                    <ComboBoxItem Content="Declined"/>
                                </ComboBox>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

        </StackPanel>
    </Grid>
</Page>
