<Page
    x:Class="MakersMarkt.ProductDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#FFFEF8E8">
    <!-- Very Light Yellow Background -->

    <Grid Padding="30">
        <StackPanel Spacing="20" HorizontalAlignment="Center" Width="400">

            <!-- Go Back Button -->
            <Button Content="Go Back" Click="GoBack_Click"
                    Width="120" Background="#FFF7D488" Foreground="Black"
                    CornerRadius="8" Padding="8,4"
                    HorizontalAlignment="Left"
                    BorderBrush="Transparent"
                    FontSize="16"/>

            <!-- Product Details Card -->
            <Border Background="White" Padding="20" CornerRadius="12" 
                    BorderBrush="#FFDFAF2B" BorderThickness="1">
                <StackPanel Spacing="15">

                    <!-- Product Name -->
                    <TextBlock x:Name="ProductName" FontSize="22" FontWeight="Bold" 
                               TextAlignment="Center" Foreground="#FF4C3000"/>

                    <!-- Product Price -->
                    <TextBlock x:Name="ProductPrice" FontSize="18" FontWeight="SemiBold"
                               Foreground="#FF8A6C1D" TextAlignment="Center"/>

                    <!-- Product Description -->
                    <TextBlock x:Name="ProductDescription" TextWrapping="WrapWholeWords"
                               FontSize="16" Foreground="Gray" TextAlignment="Center"/>

                    <!-- Buy Button -->
                    <Button Content="Buy Now" Click="BuyButton_Click" 
                            Background="#FFDFAF2B" Foreground="Black"
                            FontSize="18" Padding="10" CornerRadius="8"
                            HorizontalAlignment="Center"
                            BorderBrush="Transparent"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>
