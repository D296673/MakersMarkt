<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="MakersMarkt.LoginPage" 
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
      xmlns:local="using:MakersMarkt" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      mc:Ignorable="d" 
      Background="#FFFBEA">
    <!-- Soft warm background -->

    <Grid Background="#FFFBEA">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel HorizontalAlignment="Center" 
                    VerticalAlignment="Center" 
                    Width="400" 
                    Spacing="20" 
                    Padding="30" 
                    Background="White" 
                    CornerRadius="12" 
                    BorderThickness="1" 
                    BorderBrush="#FFDFAF2B" >

            <!-- Title -->
            <TextBlock Text="Welcome Back" 
                       FontSize="26" 
                       FontWeight="Bold" 
                       Foreground="#FF634700" 
                       TextAlignment="Center"/>

            <!-- Username Field -->
            <StackPanel>
                <TextBlock Text="Gebruikersnaam:" 
                           Foreground="#FFB74D" 
                           FontSize="18"/>
                <TextBox x:Name="NameTextBox" 
                         Width="335" 
                         FontSize="16" 
                         Padding="10" 
                         BorderBrush="#FFDFAF2B" 
                         BorderThickness="1" 
                         CornerRadius="8" 
                         Background="#FFF8E1" 
                         Foreground="Black"/>
            </StackPanel>

            <!-- Password Field -->
            <StackPanel>
                <TextBlock Text="Wachtwoord:" 
                           Foreground="#FFB74D" 
                           FontSize="18"/>
                <PasswordBox x:Name="PasswordTextBox" 
                             Width="335" 
                             FontSize="16" 
                             Padding="10" 
                             BorderBrush="#FFDFAF2B" 
                             BorderThickness="1" 
                             CornerRadius="8" 
                             Background="#FFF8E1" 
                             Foreground="Black"/>
                <TextBlock x:Name="ErrorTextBlock" 
                           Foreground="Red" 
                           FontSize="16" 
                           TextAlignment="Center"/>
            </StackPanel>

            <!-- Buttons -->
            <Button x:Name="LoginButton" 
                    Content="Login" 
                    Click="LoginButton_Click" 
                    Width="350" 
                    FontSize="18" 
                    Padding="12" 
                    Background="#FFB74D" 
                    Foreground="White" 
                    CornerRadius="8" 
                    MinWidth="200" MaxWidth="335"/>

            <Button x:Name="RegisterButton" 
                    Content="Register" 
                    Click="RegisterButton_Click" 
                    Width="350" 
                    FontSize="18" 
                    Padding="12" 
                    Background="#FFD180" 
                    Foreground="White" 
                    CornerRadius="8" 
                    MinWidth="200" MaxWidth="335"/>
        </StackPanel>
    </Grid>
</Page>
