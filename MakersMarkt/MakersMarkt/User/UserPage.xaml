<Page
    x:Class="MakersMarkt.User.UserPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MakersMarkt.Data"
    Background="#FFFCF2"> <!-- Soft light yellow -->

    <Grid Padding="30">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/> <!-- Sidebar -->
            <ColumnDefinition Width="*"/>  <!-- Product List -->
        </Grid.ColumnDefinitions>

        <!-- Left Sidebar: User Info -->
        <StackPanel Background="#F4D35E" Padding="20" Spacing="15" Grid.Column="0"
                    CornerRadius="10">
            <TextBlock Text="User Profile" FontSize="22" FontWeight="Bold" Foreground="Black"/>
            <TextBlock Text="Name:" FontWeight="SemiBold" Foreground="Black"/>
            <TextBlock x:Name="UserNameText" FontSize="18" Foreground="Black"/>
            
            <TextBlock Text="Role:" FontWeight="SemiBold" Foreground="Black"/>
            <TextBlock x:Name="UserRoleText" FontSize="18" Foreground="Black"/>

            <TextBlock Text="Joined:" FontWeight="SemiBold" Foreground="Black"/>
            <TextBlock x:Name="UserCreatedAtText" FontSize="18" Foreground="Black"/>
            
            <Button Content="Mijn Bestellingen" Click="Orders_Click" 
                    Background="#E74C3C" Foreground="White" x:Name="OrdersButton"
                    HorizontalAlignment="Stretch" CornerRadius="8" Visibility="Collapsed"/>
            <Button Content="Maak nieuw Product" Click="CreateProduct_Click" 
                    Background="#E74C3C" Foreground="White" x:Name="CreateProductButton"
                    HorizontalAlignment="Stretch" CornerRadius="8" Visibility="Collapsed"/>
            <Button Content="Log Out" Click="Logout_Click" 
                    Background="#E74C3C" Foreground="White"
                    HorizontalAlignment="Stretch" CornerRadius="8"/>
        </StackPanel>

        <!-- Right Side: User's Products -->
        <StackPanel Grid.Column="1" Padding="20" Spacing="10">
            <TextBlock Text="Your Products" FontSize="22" FontWeight="Bold" Margin="0,0,0,10"
                       Foreground="Black"/>

            <ListView x:Name="UserProductsListView">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:Product">
                        <Border Background="White" Padding="10" CornerRadius="8"
                                BorderBrush="Gray" BorderThickness="1">
                            <StackPanel Spacing="5">
                                <TextBlock Text="{x:Bind Name}" FontSize="18" FontWeight="Bold" Foreground="Black"/>
                                <TextBlock Text="Status:" FontWeight="SemiBold" Foreground="Black"/>
                                <TextBlock Text="{x:Bind Status}" Foreground="#F4A261"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </Grid>
</Page>
