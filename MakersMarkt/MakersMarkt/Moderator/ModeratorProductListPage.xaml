<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MakersMarkt.Moderator.ModeratorProductListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MakersMarkt.Moderator"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <Button Content="Back"
                    Click="BackButton_Click" />
            <TextBlock Text="Admin Product List Page"
                       FontSize="50"
                       Margin="10"
                       TextAlignment="Center" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListView Grid.Column="0"
                      x:Name="ProductListView"
                      IsItemClickEnabled="True"
                      ItemClick="ProductListView_ItemClick">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal"
                                    Spacing="2">
                            <TextBlock Text="{Binding Name}"
                                       FontSize="20" />
                            <TextBlock Text="{Binding Price}"
                                       FontSize="12"
                                       FontWeight="Light"
                                       Foreground="Gray"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel Spacing="50" Grid.Column="1">
                <StackPanel Spacing="20">
                    <TextBox x:Name="productNameTextBox" />
                    <TextBox x:Name="productDescriptionTextBox" />
                    <TextBox x:Name="productPriceTextBox" />
                    <ComboBox x:Name="typeComboBox"
                              ItemsSource="{x:Bind Types, Mode=OneWay}"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Id" />
                    <ComboBox x:Name="makersComboBox"
                              ItemsSource="{x:Bind Makers, Mode=OneWay}"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Id" />
                </StackPanel>

        </Grid>
    </Grid>
</Page>
