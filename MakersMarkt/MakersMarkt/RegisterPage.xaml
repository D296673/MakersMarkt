<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MakersMarkt.RegisterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MakersMarkt"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#FFFDF5D9">

    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="20" HorizontalAlignment="Center" VerticalAlignment="Top">
            <StackPanel Padding="40" Spacing="15" Background="White" CornerRadius="12" BorderBrush="#FFDFAF2B" BorderThickness="1">

                <!-- Username TextBox -->
                <TextBox x:Name="UserNameTextBox" Width="400" FontSize="20" Padding="12" 
                         BorderBrush="#FFDFAF2B" BorderThickness="1" CornerRadius="8" 
                         Background="#FFF8E1" Foreground="#4E4A28" 
                         PlaceholderText="Gebruikersnaam"
                         FocusVisualPrimaryBrush="#FFDFAF2B" 
                         FocusVisualSecondaryBrush="#FFDFAF2B"/>

                <!-- Password TextBox -->
                <PasswordBox x:Name="PasswordTextBox" PasswordRevealMode="Hidden" IsPasswordRevealButtonEnabled="True" 
                             FontSize="20" InputScope="Password" Padding="12" BorderBrush="#FFDFAF2B"
                             BorderThickness="1" CornerRadius="8" Background="#FFF8E1" Foreground="#4E4A28"
                             PlaceholderText="Wachtwoord"
                             FocusVisualPrimaryBrush="#FFDFAF2B" 
                             FocusVisualSecondaryBrush="#FFDFAF2B"/>

                <!-- Confirm Password TextBox -->
                <PasswordBox x:Name="ConfirmPasswordTextBox" PasswordRevealMode="Hidden" IsPasswordRevealButtonEnabled="True"
                             FontSize="20" InputScope="Password" Padding="12" BorderBrush="#FFDFAF2B"
                             BorderThickness="1" CornerRadius="8" Background="#FFF8E1" Foreground="#4E4A28"
                             PlaceholderText="Herhaal Wachtwoord"
                             FocusVisualPrimaryBrush="#FFDFAF2B" 
                             FocusVisualSecondaryBrush="#FFDFAF2B"/>

                <!-- Error Text Block -->
                <TextBlock x:Name="ErrorTextBlock" Foreground="Red" FontSize="16" TextAlignment="Center"/>

                <!-- Checkbox -->
                <CheckBox x:Name="IsCreatorCheckBox" Content="Ik ben een Maker" FontSize="20" Margin="0,15,0,0" Foreground="#4E4A28"/>

                <!-- Register Button -->
                <Button x:Name="RegisterButton" Click="RegisterButton_Click" Content="Register" FontSize="22" 
                        Padding="15,10" Width="200" HorizontalAlignment="Center" Background="#FFB74D" Foreground="#4E4A28" 
                        CornerRadius="8" Margin="0,25,0,0"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
