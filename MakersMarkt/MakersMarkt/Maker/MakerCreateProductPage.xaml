<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MakersMarkt.Maker.MakerCreateProductPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MakersMarkt.Maker"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#FFFDF5D9">

    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="20" HorizontalAlignment="Center" VerticalAlignment="Top">
            <StackPanel Padding="40" Spacing="15" Background="White" CornerRadius="12" BorderBrush="#FFDFAF2B" BorderThickness="1">

                <!-- Product naam TextBox -->
                <TextBox x:Name="ProductNameTextBox" Width="400" FontSize="20" Padding="12" 
                         BorderBrush="#FFDFAF2B" BorderThickness="1" CornerRadius="8" 
                         Background="#FFF8E1" Foreground="#4E4A28" 
                         PlaceholderText="Product Naam"
                         Header="Product Naam"
                         FocusVisualPrimaryBrush="#FFDFAF2B" 
                         FocusVisualSecondaryBrush="#FFDFAF2B"/>
                <!--Description TextBox-->
                <TextBox x:Name="ProductDescriptionTextBox" Width="400" FontSize="20" Padding="12" 
                         BorderBrush="#FFDFAF2B" BorderThickness="1" CornerRadius="8" 
                         Background="#FFF8E1" Foreground="#4E4A28" 
                         PlaceholderText="Product Beschrijving"
                         Header="Product Beschrijving"
                         FocusVisualPrimaryBrush="#FFDFAF2B" 
                         FocusVisualSecondaryBrush="#FFDFAF2B"
                         AcceptsReturn="True" TextWrapping="Wrap" Height="200"/>

                <!-- Type ComboBox -->
                <ComboBox x:Name="ProductTypeComboBox" Width="400" FontSize="20" Padding="12" 
                          BorderBrush="#FFDFAF2B" BorderThickness="1" CornerRadius="8" 
                          Background="#FFF8E1" Foreground="#4E4A28" 
                          PlaceholderText="Product Type"
                          Header="Product Type"
                          FocusVisualPrimaryBrush="#FFDFAF2B" 
                          FocusVisualSecondaryBrush="#FFDFAF2B"/>
                <!-- Material Textbox -->
                <TextBox x:Name="ProductMaterialTextBox" Width="400" FontSize="20" Padding="12" 
                         BorderBrush="#FFDFAF2B" BorderThickness="1" CornerRadius="8" 
                         Background="#FFF8E1" Foreground="#4E4A28" 
                         PlaceholderText="Product Materiaal"
                         Header="Product Materiaal"
                         FocusVisualPrimaryBrush="#FFDFAF2B" 
                         FocusVisualSecondaryBrush="#FFDFAF2B"/>
                <!-- Production Time Textbox -->
                <TextBox x:Name="ProductProductionTimeTextBox" Width="400" FontSize="20" Padding="12" 
                         BorderBrush="#FFDFAF2B" BorderThickness="1" CornerRadius="8" 
                         Background="#FFF8E1" Foreground="#4E4A28" 
                         PlaceholderText="Product Productie Tijd"
                         Header="Product Productie Tijd"
                         FocusVisualPrimaryBrush="#FFDFAF2B" 
                         FocusVisualSecondaryBrush="#FFDFAF2B"/>
                <!-- Complexity Textbox -->
                <TextBox x:Name="ProductComplexityTextBox" Width="400" FontSize="20" Padding="12" 
                         BorderBrush="#FFDFAF2B" BorderThickness="1" CornerRadius="8" 
                         Background="#FFF8E1" Foreground="#4E4A28" 
                         PlaceholderText="Product Complexiteit"
                         Header="Product Complexiteit"
                         FocusVisualPrimaryBrush="#FFDFAF2B" 
                         FocusVisualSecondaryBrush="#FFDFAF2B"/>
                <!-- Durability Textbox -->
                <TextBox x:Name="ProductDurabilityTextBox" Width="400" FontSize="20" Padding="12" 
                         BorderBrush="#FFDFAF2B" BorderThickness="1" CornerRadius="8" 
                         Background="#FFF8E1" Foreground="#4E4A28" 
                         PlaceholderText="Product Duurzaamheid"
                         Header="Product Duurzaamheid"
                         FocusVisualPrimaryBrush="#FFDFAF2B" 
                         FocusVisualSecondaryBrush="#FFDFAF2B"/>
                <!-- Unique Features Textbox -->
                <TextBox x:Name="ProductUniqueFeaturesTextBox" Width="400" FontSize="20" Padding="12" 
                         BorderBrush="#FFDFAF2B" BorderThickness="1" CornerRadius="8" 
                         Background="#FFF8E1" Foreground="#4E4A28" 
                         PlaceholderText="Product Unieke Eigenschappen"
                         Header="Product Unieke Eigenschappen"
                         FocusVisualPrimaryBrush="#FFDFAF2B" 
                         FocusVisualSecondaryBrush="#FFDFAF2B"/>
                <!-- Price Textbox -->
                <TextBox x:Name="ProductPriceTextBox" Width="400" FontSize="20" Padding="12" 
                         BorderBrush="#FFDFAF2B" BorderThickness="1" CornerRadius="8" 
                         Background="#FFF8E1" Foreground="#4E4A28" 
                         PlaceholderText="Product Prijs"
                         Header="Product Prijs"
                         FocusVisualPrimaryBrush="#FFDFAF2B" 
                         FocusVisualSecondaryBrush="#FFDFAF2B"/>



                <!-- Error Text Block -->
                <TextBlock x:Name="ErrorTextBlock" Foreground="Red" FontSize="16" TextAlignment="Center"/>
                
                <!-- Create Button -->
                <Button x:Name="CreateProductButton" Click="CreateProductButton_Click" Content="Maak Product" FontSize="22" 
                        Padding="15,10" Width="200" HorizontalAlignment="Center" Background="#FFB74D" Foreground="#4E4A28" 
                        CornerRadius="8" Margin="0,25,0,0"/>


                <!-- Go Back Button -->
                <Button x:Name="GoBackButton" Click="GoBackButton_Click" Content="Terug naar Profiel" FontSize="22" 
                        Padding="15,10" Width="200" HorizontalAlignment="Center" Background="#FFB74D" Foreground="#4E4A28" 
                        CornerRadius="8" Margin="0,10,0,0"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
